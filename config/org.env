# ───────────────────────────────────────────────────────────────────────────
#  Configuración global de la organización GitHub · Spa de Uñas (Inventario)
# ───────────────────────────────────────────────────────────────────────────
# Nombre EXACTO (login) de la organización, creada previamente en github.com
ORG="Proyecto-Maestria-Spa-Unas"

# Ramas
DEFAULT_BRANCH="main"          # producción (protegida)
INTEGRATION_BRANCH="develop"   # integración (protegida)

# Revisión de código
REQUIRED_APPROVALS=1           # subir a 2 cuando el equipo crezca

# Puerta de QA: "false" hasta que spa-qa esté operativo; luego "true" y
# ejecutar: ./bootstrap.sh 06   (re-aplica rulesets con el check de QA)
ENABLE_QA_GATE="false"

# Tablero de GitHub Projects (v2) a nivel de organización
PROJECT_TITLE="Spa de Uñas · Inventario"

# Re-sembrar repos que ya tienen commits (peligroso). Normalmente "false".
FORCE_SEED="false"
